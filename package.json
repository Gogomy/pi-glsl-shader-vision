{
  "name": "@gogomi/pi-glsl-shader-vision",
  "version": "0.2.1",
  "type": "module",
  "description": "GLSL fragment shader viewer for Pi Agent — live WebGL preview, Tweakpane uniform controls, presets, probe sheets & video export",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gogomy/pi-glsl-shader-vision.git"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "pi-skill",
    "glsl",
    "shader",
    "webgl",
    "shadertoy",
    "fragment-shader",
    "preview"
  ],
  "author": "",
  "license": "MIT",
  "main": "index.ts",
  "files": [
    "index.ts",
    "preview-server.mjs",
    "scripts/render-probe.mjs",
    "preview-server.d.mts",
    "scripts/render-probe.d.mts",
    "public/index.html",
    "public/viewer.js",
    "public/style.css",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md",
    "skills/glsl-shader-vision/SKILL.md",
    "examples/shaders/pool_wave.frag",
    "examples/shaders/pool_wave.params.json",
    "examples/shaders/pool_wave.presets.json",
    "examples/shaders/trigger_effect.frag",
    "examples/shaders/trigger_effect.params.json",
    "examples/shaders/trigger_effect.presets.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "puppeteer": "^24.42.0"
  },
  "scripts": {
    "server": "node preview-server.mjs",
    "probe": "node scripts/render-probe.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills/glsl-shader-vision"
    ]
  }
}
